#!/usr/bin/env bash
# pre-push — gate local de vivienda-osint.
# Sustituye al CI de GitHub Actions (deshabilitado a nivel de cuenta: los runs
# salen "No jobs were run" y solo generan correos). Corre la suite ANTES de cada
# push y BLOQUEA si falla.
#
# IMPORTANTE: NO usa tests/crea_fixture.py — ese script escribe data/vivienda.db
# (la BD REAL) con datos sintéticos; en este server la clobberaría. Aquí se valida
# el contrato contra la BD real (igual que la puerta de staging del cron).
#
# Instalación:  cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Saltar en urgencia:  git push --no-verify
set -u
cd /home/deploy/vivienda-osint || exit 0
PY=./venv/bin/python
echo "[pre-push] suite local de vivienda (compileall + contrato + watchdog + territorios)…"
fail=0

$PY -m compileall -q ingest gen scripts tests || fail=1

rm -rf web_ci
if [ -f data/vivienda.db ]; then
  $PY gen/gen_vivienda.py --out web_ci >/dev/null 2>&1 || { echo "[pre-push] gen FALLO"; fail=1; }
  $PY tests/test_datos.py --web-dir web_ci || fail=1
else
  echo "[pre-push] sin data/vivienda.db: se omiten gen + contrato"
fi
$PY tests/test_watchdog_rdl.py || fail=1
$PY tests/test_territorios.py || fail=1
rm -rf web_ci

if [ "$fail" -eq 0 ]; then
  echo "[pre-push] OK — push permitido"
  exit 0
fi
echo "[pre-push] FALLO — push BLOQUEADO (git push --no-verify para saltar)"
exit 1
